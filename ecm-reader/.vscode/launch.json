{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Cargo Binary",
            "cargo": {
                "args": [
                    "build",
                    "--bin",
                    "ecm-reader"
                ],
                "filter": {
                    "name": "ecm-reader",
                    "kind": "bin"
                }
            },
            "args": [
                "--",
                "http://bg.cesbo.com:8011/btv",
                "5256",
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}